<UserControl x:Class="OpenAdoration.WPF.Views.StageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:OpenAdoration.WPF.ViewModels"
             xmlns:loc="clr-namespace:OpenAdoration.WPF.Localization"
             xmlns:helpers="clr-namespace:OpenAdoration.WPF.Helpers"
             xmlns:behaviors="clr-namespace:OpenAdoration.WPF.Behaviors"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:ffme="clr-namespace:Unosquare.FFME;assembly=ffme.win"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:StageViewModel}"
             Background="{DynamicResource PrimaryBrush}"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- Status bar -->
            <RowDefinition Height="Auto" />  <!-- F7: quick style bar (song-only) -->
            <RowDefinition Height="*" />     <!-- Slide panels -->
        </Grid.RowDefinitions>

        <!-- ── Status bar ── -->
        <Border Grid.Row="0"
                Background="{DynamicResource PrimaryBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- LIVE / STOPPED badge -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <Border Background="{DynamicResource AccentBrush}"
                            CornerRadius="3" Padding="8,3"
                            Visibility="{Binding IsProjecting, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="● LIVE" Foreground="White" FontSize="11" FontWeight="Bold" />
                    </Border>
                    <Border Background="{DynamicResource BorderBrush}"
                            CornerRadius="3" Padding="8,3"
                            Visibility="{Binding IsProjecting, Converter={StaticResource InverseBoolToVis}}">
                        <TextBlock Text="{loc:Loc Stage_Stopped}" Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="11" FontWeight="Bold" />
                    </Border>
                </StackPanel>

                <!-- Context label -->
                <TextBlock x:Name="ContextLabelText"
                           Grid.Column="1"
                           Text="{Binding ContextLabel}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="14" FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />

                <!-- Slide position + schedule navigation -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SlidePosition}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="13" VerticalAlignment="Center"
                               Margin="0,0,16,0" />

                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsServiceScheduleActive, Converter={StaticResource BoolToVis}}">
                        <Button Content="{loc:Loc Stage_PrevItem}"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding PrevItemCommand}"
                                Padding="10,6" Margin="0,0,6,0" />
                        <Button Content="{loc:Loc Stage_NextItem}"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding NextItemCommand}"
                                Padding="10,6" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── F7: live style editor — writes into a real, per-scope Theme row for the live song ── -->
        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,8"
                Visibility="{Binding IsStyleEditorLive, Converter={StaticResource BoolToVis}}">
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="{loc:Loc Stage_QuickStyle}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,10,0" />

                <!-- Scope: which cascade level this edit writes to -->
                <Border BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="4"
                        ClipToBounds="True" Margin="0,0,14,0"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton x:Name="ScopeSongToggle"
                                      Content="{loc:Loc Stage_ScopeSong}"
                                      Style="{StaticResource AlignToggleButton}"
                                      IsEnabled="{Binding IsSongScopeAvailable}"
                                      IsChecked="{Binding IsScopeSong, Mode=OneWay}"
                                      Command="{Binding SetScopeCommand}"
                                      CommandParameter="Song" />
                        <Rectangle Width="1" Fill="{DynamicResource BorderBrush}" />
                        <ToggleButton x:Name="ScopeOccurrenceToggle"
                                      Content="{loc:Loc Stage_ScopeOccurrence}"
                                      Style="{StaticResource AlignToggleButton}"
                                      IsEnabled="{Binding IsOccurrenceScopeAvailable}"
                                      IsChecked="{Binding IsScopeOccurrence, Mode=OneWay}"
                                      Command="{Binding SetScopeCommand}"
                                      CommandParameter="ThisOccurrence" />
                    </StackPanel>
                </Border>

                <!-- Font size stepper -->
                <Button x:Name="DecreaseFontSizeButton" Content="A−" Width="44" Height="44" Margin="0,0,2,0"
                        Style="{StaticResource SecondaryButton}"
                        ToolTip="{loc:Loc Stage_FontSizeDecrease}"
                        Command="{Binding DecreaseFontSizeCommand}" />
                <TextBlock x:Name="FontSizeValueText"
                           Text="{Binding EditableFontSize, StringFormat={}{0}pt}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="12" MinWidth="34" TextAlignment="Center"
                           VerticalAlignment="Center" />
                <Button x:Name="IncreaseFontSizeButton" Content="A+" Width="44" Height="44" Margin="2,0,14,0"
                        Style="{StaticResource SecondaryButton}"
                        ToolTip="{loc:Loc Stage_FontSizeIncrease}"
                        Command="{Binding IncreaseFontSizeCommand}" />

                <!-- Text colour -->
                <!-- Foreground is a fixed dark color, not DynamicResource (contra G27): the popup's own
                     background is always light, regardless of app theme, so a dark-theme white Foreground
                     was rendering illegible white-on-white RGBA labels inside it. -->
                <xctk:ColorPicker x:Name="FontColorPicker"
                                  SelectedColor="{Binding EditableFontColor}"
                                  ToolTip="{loc:Loc Stage_TextColor}"
                                  Background="{DynamicResource PrimaryBrush}"
                                  Foreground="#1E1E2E"
                                  BorderBrush="{DynamicResource BorderBrush}"
                                  UsingAlphaChannel="False"
                                  ShowRecentColors="True"
                                  ShowAvailableColors="True"
                                  ColorMode="ColorCanvas"
                                  Width="90" Height="32" Margin="0,0,14,0"
                                  VerticalAlignment="Center" />

                <!-- Background type selector -->
                <Border BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="4"
                        ClipToBounds="True" Margin="0,0,10,0"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton x:Name="BgTypeColorToggle"
                                      Content="{loc:Loc ThemeEdit_BgColor}"
                                      Style="{StaticResource AlignToggleButton}"
                                      IsChecked="{Binding IsEditableBackgroundColor, Mode=OneWay}"
                                      Command="{Binding SetBackgroundTypeCommand}"
                                      CommandParameter="Color" />
                        <Rectangle Width="1" Fill="{DynamicResource BorderBrush}" />
                        <ToggleButton x:Name="BgTypeImageToggle"
                                      Content="{loc:Loc ThemeEdit_BgImage}"
                                      Style="{StaticResource AlignToggleButton}"
                                      IsChecked="{Binding IsEditableBackgroundImage, Mode=OneWay}"
                                      Command="{Binding SetBackgroundTypeCommand}"
                                      CommandParameter="Image" />
                        <Rectangle Width="1" Fill="{DynamicResource BorderBrush}" />
                        <ToggleButton x:Name="BgTypeVideoToggle"
                                      Content="{loc:Loc ThemeEdit_BgVideo}"
                                      Style="{StaticResource AlignToggleButton}"
                                      IsChecked="{Binding IsEditableBackgroundVideo, Mode=OneWay}"
                                      Command="{Binding SetBackgroundTypeCommand}"
                                      CommandParameter="Video" />
                    </StackPanel>
                </Border>

                <!-- Background: colour -->
                <xctk:ColorPicker x:Name="BackgroundColorPicker"
                                  Visibility="{Binding IsEditableBackgroundColor, Converter={StaticResource BoolToVis}}"
                                  SelectedColor="{Binding EditableBackgroundColor}"
                                  ToolTip="{loc:Loc Stage_BackgroundColor}"
                                  Background="{DynamicResource PrimaryBrush}"
                                  Foreground="#1E1E2E"
                                  BorderBrush="{DynamicResource BorderBrush}"
                                  UsingAlphaChannel="False"
                                  ShowRecentColors="True"
                                  ShowAvailableColors="True"
                                  ColorMode="ColorCanvas"
                                  Width="90" Height="32"
                                  VerticalAlignment="Center" />

                <!-- Background: image (browse/clear + pick from library) -->
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding IsEditableBackgroundImage, Converter={StaticResource BoolToVis}}">
                    <Button x:Name="BrowseBackgroundImageButton"
                            Content="{loc:Loc Common_Browse}"
                            Style="{StaticResource SecondaryButton}"
                            Padding="10,6" Margin="0,0,4,0"
                            Click="OnBrowseBackgroundImageClick" />
                    <Button x:Name="ClearBackgroundImageButton"
                            Content="✕"
                            Style="{StaticResource IconDangerButton}"
                            Click="OnClearBackgroundImageClick"
                            Visibility="{Binding HasEditableBackgroundImage, Converter={StaticResource BoolToVis}}"
                            Margin="0,0,4,0" />
                    <ComboBox x:Name="BackgroundImageLibraryCombo"
                              Style="{StaticResource FieldComboBox}"
                              Width="160"
                              ItemsSource="{Binding BackgroundImages}"
                              SelectedItem="{Binding SelectedLibraryImage}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Image behaviors:ThumbnailImage.Source="{Binding FilePath}"
                                           Width="32" Height="18" Stretch="UniformToFill" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding FileName}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <!-- Background: video (browse/clear + pick from library) -->
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding IsEditableBackgroundVideo, Converter={StaticResource BoolToVis}}">
                    <Button x:Name="BrowseBackgroundVideoButton"
                            Content="{loc:Loc Common_Browse}"
                            Style="{StaticResource SecondaryButton}"
                            Padding="10,6" Margin="0,0,4,0"
                            Click="OnBrowseBackgroundVideoClick" />
                    <Button x:Name="ClearBackgroundVideoButton"
                            Content="✕"
                            Style="{StaticResource IconDangerButton}"
                            Click="OnClearBackgroundVideoClick"
                            Visibility="{Binding HasEditableBackgroundVideo, Converter={StaticResource BoolToVis}}"
                            Margin="0,0,4,0" />
                    <ComboBox x:Name="BackgroundVideoLibraryCombo"
                              Style="{StaticResource FieldComboBox}"
                              Width="160"
                              ItemsSource="{Binding BackgroundVideos}"
                              SelectedItem="{Binding SelectedLibraryVideo}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Image behaviors:ThumbnailImage.Source="{Binding FilePath}"
                                           Width="32" Height="18" Stretch="UniformToFill" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding FileName}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- ── Two-panel content area ── -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- ─────────── CURRENT SLIDE ─────────── -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Projection preview -->
                <Viewbox Grid.Row="0" Stretch="Uniform" Margin="16,12,16,8">
                    <Grid Width="1920" Height="1080" ClipToBounds="True">

                        <!-- Layer 1: background colour -->
                        <Rectangle Fill="{Binding CurrentPreview.BgColor, Converter={StaticResource ColorToBrush}}" />

                        <!-- Layer 2: background image -->
                        <Image Source="{Binding CurrentPreview.BgImagePath, Converter={StaticResource FilePathToImage}}"
                               Stretch="UniformToFill"
                               Visibility="{Binding CurrentPreview.HasBgImage, Converter={StaticResource BoolToVis}}" />

                        <!-- Layer 3: theme background video — mirrors the projector (muted, looping,
                             any codec via FFME). The body text in Layer 4 overlays it. -->
                        <ffme:MediaElement x:Name="CurrentBgVideo"
                                           LoadedBehavior="Play"
                                           UnloadedBehavior="Manual"
                                           IsMuted="True"
                                           Stretch="UniformToFill"
                                           MediaEnded="OnCurrentBgVideoEnded"
                                           Visibility="{Binding CurrentPreview.HasBgVideo, Converter={StaticResource BoolToVis}}" />

                        <!-- Layer 4: Song / Bible 3-zone text layout -->
                        <Grid Visibility="{Binding CurrentPreview.IsText, Converter={StaticResource BoolToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Header zone -->
                            <TextBlock Grid.Row="0"
                                       Text="{Binding CurrentPreview.HeaderText}"
                                       Visibility="{Binding CurrentPreview.HasHeader, Converter={StaticResource BoolToVis}}"
                                       Foreground="{Binding CurrentPreview.FontColor, Converter={StaticResource ColorToBrush}}"
                                       FontFamily="{Binding CurrentPreview.FontFamily}"
                                       FontSize="56"
                                       Padding="80,30,80,10"
                                       TextAlignment="Right"
                                       TextWrapping="NoWrap" />

                            <!-- Body zone -->
                            <Viewbox Grid.Row="1" Margin="120,30,120,30">
                                <TextBlock helpers:BoldMarkupText.Text="{Binding CurrentPreview.Content}"
                                           Width="1680"
                                           FontFamily="{Binding CurrentPreview.FontFamily}"
                                           FontSize="{Binding CurrentPreview.FontSize}"
                                           Foreground="{Binding CurrentPreview.FontColor, Converter={StaticResource ColorToBrush}}"
                                           TextAlignment="{Binding CurrentPreview.TextAlignment}"
                                           TextWrapping="Wrap" />
                            </Viewbox>

                            <!-- Footer zone -->
                            <TextBlock Grid.Row="2"
                                       Text="{Binding CurrentPreview.FooterText}"
                                       Visibility="{Binding CurrentPreview.HasFooter, Converter={StaticResource BoolToVis}}"
                                       Foreground="{Binding CurrentPreview.FontColor, Converter={StaticResource ColorToBrush}}"
                                       FontFamily="{Binding CurrentPreview.FontFamily}"
                                       FontSize="44"
                                       Padding="80,10,80,24"
                                       TextAlignment="Center"
                                       TextWrapping="NoWrap"
                                       Opacity="0.85" />
                        </Grid>

                        <!-- Layer 5: media image -->
                        <Image Source="{Binding CurrentPreview.MediaPath, Converter={StaticResource FilePathToImage}}"
                               Stretch="Uniform"
                               Visibility="{Binding CurrentPreview.IsImageMedia, Converter={StaticResource BoolToVis}}" />

                        <!-- Layer 6: media video (muted live preview, FFME: any codec) -->
                        <ffme:MediaElement x:Name="CurrentVideoMedia"
                                           LoadedBehavior="Play"
                                           UnloadedBehavior="Manual"
                                           IsMuted="True"
                                           Stretch="Uniform"
                                           MediaEnded="OnCurrentVideoEnded"
                                           Visibility="{Binding CurrentPreview.IsVideoMedia, Converter={StaticResource BoolToVis}}" />

                        <!-- Layer 7: blank overlay -->
                        <Rectangle Fill="Black"
                                   Visibility="{Binding CurrentPreview.IsBlank, Converter={StaticResource BoolToVis}}" />

                        <!-- Announcement banner overlay -->
                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                                Margin="80,0,80,90" Padding="40,22" CornerRadius="10"
                                Background="#2563EB"
                                Visibility="{Binding HasAnnouncement, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding AnnouncementText}"
                                       Foreground="White" FontSize="44" FontWeight="SemiBold"
                                       TextWrapping="Wrap" TextAlignment="Center" />
                        </Border>

                        <!-- Persistent lower-third mirror — band styling + scroll ticker replay the projector. -->
                        <Border x:Name="LowerThirdBar" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                                Padding="60,18"
                                ClipToBounds="True"
                                Background="{Binding LowerThirdBandColor, Converter={StaticResource HexToBrush}}"
                                Visibility="{Binding HasLowerThird, Converter={StaticResource BoolToVis}}">
                            <TextBlock x:Name="LowerThirdTextBlock" Text="{Binding LowerThirdText}"
                                       Foreground="{Binding LowerThirdTextColor, Converter={StaticResource HexToBrush}}"
                                       FontSize="{Binding LowerThirdFontSize}" FontWeight="SemiBold"
                                       TextWrapping="Wrap" TextAlignment="Center" />
                        </Border>

                        <!-- Layer 8: not-projecting dim -->
                        <Border Background="#CC12121E"
                                Visibility="{Binding IsProjecting, Converter={StaticResource InverseBoolToVis}}">
                            <TextBlock Text="{loc:Loc Stage_NotProjecting}"
                                       Foreground="#44667799" FontSize="80" FontStyle="Italic"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Viewbox>

                <!-- Section label + slide position below the preview -->
                <Border Grid.Row="1" Background="{DynamicResource PrimaryBrush}" Padding="16,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding CurrentPreview.SectionLabel}"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontSize="11" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding SlidePosition}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="11" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Column separator -->
            <Rectangle Grid.Column="1" Fill="{DynamicResource BorderBrush}" />

            <!-- ─────────── NEXT SLIDE ─────────── -->
            <Grid Grid.Column="2" Background="{DynamicResource SurfaceBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- "UP NEXT" header -->
                <Border Grid.Row="0" Background="{DynamicResource PrimaryBrush}" Padding="14,8">
                    <TextBlock Text="{loc:Loc Stage_UpNext}"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
                </Border>

                <!-- Next slide preview OR placeholder -->
                <Grid Grid.Row="1">

                    <!-- No-next placeholder -->
                    <TextBlock Text="{loc:Loc Stage_EndOfItem}"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" FontStyle="Italic"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding HasNextSlide, Converter={StaticResource InverseBoolToVis}}" />

                    <!-- Projection preview (same layer stack, smaller Viewbox) -->
                    <Viewbox Stretch="Uniform" Margin="10,8,10,8"
                             Visibility="{Binding HasNextSlide, Converter={StaticResource BoolToVis}}">
                        <Grid Width="1920" Height="1080" ClipToBounds="True">

                            <Rectangle Fill="{Binding NextPreview.BgColor, Converter={StaticResource ColorToBrush}}" />

                            <Image Source="{Binding NextPreview.BgImagePath, Converter={StaticResource FilePathToImage}}"
                                   Stretch="UniformToFill"
                                   Visibility="{Binding NextPreview.HasBgImage, Converter={StaticResource BoolToVis}}" />

                            <ffme:MediaElement x:Name="NextBgVideo"
                                               LoadedBehavior="Play"
                                               UnloadedBehavior="Manual"
                                               IsMuted="True"
                                               Stretch="UniformToFill"
                                               MediaEnded="OnNextBgVideoEnded"
                                               Visibility="{Binding NextPreview.HasBgVideo, Converter={StaticResource BoolToVis}}" />

                            <Grid Visibility="{Binding NextPreview.IsText, Converter={StaticResource BoolToVis}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"
                                           Text="{Binding NextPreview.HeaderText}"
                                           Visibility="{Binding NextPreview.HasHeader, Converter={StaticResource BoolToVis}}"
                                           Foreground="{Binding NextPreview.FontColor, Converter={StaticResource ColorToBrush}}"
                                           FontFamily="{Binding NextPreview.FontFamily}"
                                           FontSize="56" Padding="80,30,80,10"
                                           TextAlignment="Right" TextWrapping="NoWrap" />
                                <Viewbox Grid.Row="1" Margin="120,30,120,30">
                                    <TextBlock x:Name="NextPreviewContentText"
                                               helpers:BoldMarkupText.Text="{Binding NextPreview.Content}"
                                               Width="1680"
                                               FontFamily="{Binding NextPreview.FontFamily}"
                                               FontSize="{Binding NextPreview.FontSize}"
                                               Foreground="{Binding NextPreview.FontColor, Converter={StaticResource ColorToBrush}}"
                                               TextAlignment="{Binding NextPreview.TextAlignment}"
                                               TextWrapping="Wrap" />
                                </Viewbox>
                                <TextBlock Grid.Row="2"
                                           Text="{Binding NextPreview.FooterText}"
                                           Visibility="{Binding NextPreview.HasFooter, Converter={StaticResource BoolToVis}}"
                                           Foreground="{Binding NextPreview.FontColor, Converter={StaticResource ColorToBrush}}"
                                           FontFamily="{Binding NextPreview.FontFamily}"
                                           FontSize="44" Padding="80,10,80,24"
                                           TextAlignment="Center" TextWrapping="NoWrap" Opacity="0.85" />
                            </Grid>

                            <Image Source="{Binding NextPreview.MediaPath, Converter={StaticResource FilePathToImage}}"
                                   Stretch="Uniform"
                                   Visibility="{Binding NextPreview.IsImageMedia, Converter={StaticResource BoolToVis}}" />

                            <ffme:MediaElement x:Name="NextVideoMedia"
                                               LoadedBehavior="Play"
                                               UnloadedBehavior="Manual"
                                               IsMuted="True"
                                               Stretch="Uniform"
                                               MediaEnded="OnNextVideoEnded"
                                               Visibility="{Binding NextPreview.IsVideoMedia, Converter={StaticResource BoolToVis}}" />

                            <Rectangle Fill="Black"
                                       Visibility="{Binding NextPreview.IsBlank, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Viewbox>
                </Grid>

                <!-- Next section label -->
                <Border Grid.Row="2" Background="{DynamicResource PrimaryBrush}" Padding="14,6">
                    <TextBlock Text="{Binding NextPreview.SectionLabel}"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" />
                </Border>
            </Grid>

            <!-- Column separator -->
            <Rectangle Grid.Column="3" Fill="{DynamicResource BorderBrush}" />

            <!-- ─────────── ALL SLIDES (clickable list) ─────────── -->
            <Grid Grid.Column="4" Background="{DynamicResource SurfaceBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- "ALL SLIDES" header -->
                <Border Grid.Row="0" Background="{DynamicResource PrimaryBrush}" Padding="14,8">
                    <TextBlock Text="{loc:Loc Stage_AllSlides}"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding AllSlides}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button HorizontalContentAlignment="Stretch"
                                        Padding="0" BorderThickness="0" Cursor="Hand"
                                        MinHeight="44"
                                        Command="{Binding DataContext.JumpToSlideCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Index}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="SlideBd"
                                                    Background="Transparent"
                                                    BorderThickness="0,0,0,1"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    Padding="14,8">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Label}"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               FontSize="12" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding PreviewText}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               FontSize="11" Margin="0,2,0,0"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter TargetName="SlideBd" Property="Background"
                                                            Value="{DynamicResource AccentBrush}" />
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="SlideBd" Property="Background"
                                                            Value="{DynamicResource ActiveNavBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
