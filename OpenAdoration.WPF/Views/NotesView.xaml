<UserControl x:Class="OpenAdoration.WPF.Views.NotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:OpenAdoration.WPF.ViewModels"
             xmlns:views="clr-namespace:OpenAdoration.WPF.Views"
             xmlns:loc="clr-namespace:OpenAdoration.WPF.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:NotesViewModel}"
             Loaded="OnLoaded">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" MinWidth="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════ LEFT: Notes list ══ -->
        <Grid Grid.Column="0"
              Background="{DynamicResource PrimaryBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Search + New button header -->
            <Border Grid.Row="0"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,1"
                    Padding="12,12,12,10">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{loc:Loc Notes_Title}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Content="{loc:Loc Common_New}"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding NewNoteCommand}"
                                Padding="10,6" />
                    </Grid>

                    <!-- Search -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Style="{StaticResource SearchTextBox}"
                                 Tag="{loc:Loc Notes_SearchPlaceholder}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,6,0">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="1"
                                Content="&#xE721;"
                                FontFamily="Segoe Fluent Icons"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding SearchCommand}"
                                Padding="8,6" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Notes list -->
            <Border Grid.Row="1"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <!-- Loading indicator -->
                    <TextBlock Text="{loc:Loc Common_Loading}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

                    <!-- Error -->
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{DynamicResource DangerBrush}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Margin="12"
                               VerticalAlignment="Top"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />

                    <!-- Empty state — no notes exist yet -->
                    <TextBlock Text="{loc:Loc Notes_Empty}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="16">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsBusy}"        Value="False" />
                                            <Condition Binding="{Binding HasError}"       Value="False" />
                                            <Condition Binding="{Binding Notes.Count}"    Value="0" />
                                            <Condition Binding="{Binding HasSearchText}"  Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Empty state — search returned nothing -->
                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="16">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource LocFormat}">
                                <Binding Path="[Notes_NoResults]" Source="{x:Static loc:TranslationSource.Instance}" />
                                <Binding Path="SearchText" />
                            </MultiBinding>
                        </TextBlock.Text>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsBusy}"        Value="False" />
                                            <Condition Binding="{Binding HasError}"       Value="False" />
                                            <Condition Binding="{Binding Notes.Count}"    Value="0" />
                                            <Condition Binding="{Binding HasSearchText}"  Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Note rows — ListBox enables WPF virtualization (P2) -->
                    <ListBox ItemsSource="{Binding Notes}"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SongRowCard}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Title + action buttons -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Title}"
                                                       ToolTip="{Binding Title}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,6,0"
                                                       TextTrimming="CharacterEllipsis" />
                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Right">
                                                <Button Content="▶"
                                                        Style="{StaticResource IconButton}"
                                                        ToolTip="{loc:Loc Common_Project}"
                                                        Command="{Binding DataContext.ProjectNoteCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="✎"
                                                        Style="{StaticResource IconButton}"
                                                        ToolTip="{loc:Loc Common_Edit}"
                                                        Command="{Binding DataContext.EditNoteCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Margin="2,0" />
                                                <Button Content="✕"
                                                        Style="{StaticResource IconDangerButton}"
                                                        ToolTip="{loc:Loc Common_Delete}"
                                                        Command="{Binding DataContext.DeleteNoteCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Content preview -->
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Content}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="11"
                                                   Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════ RIGHT: Edit / Placeholder ══ -->

        <!-- Add/Edit form (visible when IsEditing = true) -->
        <views:AddEditNoteView Grid.Column="1"
                               DataContext="{Binding EditViewModel}"
                               Visibility="{Binding DataContext.IsEditing,
                                            RelativeSource={RelativeSource AncestorType=UserControl},
                                            Converter={StaticResource BoolToVis}}" />

        <!-- Placeholder (visible when IsEditing = false) -->
        <Grid Grid.Column="1"
              Background="{DynamicResource SurfaceBrush}"
              Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVis}}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="{loc:Loc Notes_SelectPrompt}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="16"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{loc:Loc Notes_SelectPromptSub}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Grid>

    </Grid>
</UserControl>
