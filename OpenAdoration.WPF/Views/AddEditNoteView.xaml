<UserControl x:Class="OpenAdoration.WPF.Views.AddEditNoteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:OpenAdoration.WPF.ViewModels"
             xmlns:loc="clr-namespace:OpenAdoration.WPF.Localization"
             d:DataContext="{d:DesignInstance Type=vm:AddEditNoteViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{DynamicResource SurfaceBrush}">

    <Grid>
        <!-- Busy overlay -->
        <Grid Panel.ZIndex="10"
              Background="#80000000"
              Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{loc:Loc Common_Saving}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="16"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Main layout -->
        <DockPanel>

            <!-- ── Footer: error + action buttons ── -->
            <Border DockPanel.Dock="Bottom"
                    Background="{DynamicResource PrimaryBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="20,12">
                <Grid>
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{DynamicResource DangerBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"
                               TextWrapping="Wrap"
                               MaxWidth="400"
                               HorizontalAlignment="Left" />

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Content="{loc:Loc Common_Cancel}"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding CancelCommand}"
                                Margin="0,0,8,0" />
                        <Button Content="{loc:Loc NoteEdit_Save}"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding SaveCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── Scrollable form ── -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,20,24,24">

                    <TextBlock Text="{Binding FormTitle}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Margin="0,0,0,20" />

                    <!-- Title field -->
                    <TextBlock Text="{loc:Loc NoteEdit_TitleField}" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="NoteEditTitleBox"
                             Style="{StaticResource FieldTextBox}"
                             Tag="{loc:Loc NoteEdit_TitlePlaceholder}"
                             MaxLength="200"
                             Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,14" />

                    <!-- Theme (per-note override; default = inherit service/app theme) -->
                    <TextBlock Text="{loc:Loc SongEdit_Theme}" Style="{StaticResource FieldLabel}" />
                    <ComboBox Style="{StaticResource FieldComboBox}"
                              Width="260" HorizontalAlignment="Left"
                              ItemsSource="{Binding AvailableThemes}"
                              SelectedItem="{Binding SelectedTheme}"
                              Margin="0,0,0,4">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="{loc:Loc SongEdit_ThemeHelp}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="11" Margin="0,0,0,20" TextWrapping="Wrap" />

                    <!-- Content field -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="{loc:Loc Notes_Content}" Style="{StaticResource FieldLabel}" Margin="0,0,12,0" />
                        <TextBlock Text="{loc:Loc Notes_ContentHint}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="11" VerticalAlignment="Bottom" />
                    </StackPanel>
                    <TextBox x:Name="NoteEditContentBox"
                             Style="{StaticResource LyricsTextBox}"
                             Tag="{loc:Loc Notes_ContentPlaceholder}"
                             Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}"
                             PreviewKeyDown="OnContentPreviewKeyDown"
                             MinHeight="240" />

                </StackPanel>
            </ScrollViewer>

        </DockPanel>
    </Grid>
</UserControl>
