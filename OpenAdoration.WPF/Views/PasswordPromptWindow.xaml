<Window x:Class="OpenAdoration.WPF.Views.PasswordPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:OpenAdoration.WPF.Localization"
        Width="380" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}">

    <StackPanel Margin="24,20,24,20">

        <TextBlock x:Name="MessageText"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   FontSize="13"
                   TextWrapping="Wrap"
                   Margin="0,0,0,16" />

        <TextBlock Text="{loc:Loc Backup_PasswordField}" Style="{StaticResource FieldLabel}" />
        <PasswordBox x:Name="PasswordBox1"
                     Background="{DynamicResource PrimaryBrush}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     CaretBrush="{DynamicResource TextPrimaryBrush}"
                     BorderBrush="{DynamicResource BorderBrush}"
                     BorderThickness="1"
                     FontSize="13"
                     Padding="10,8"
                     Margin="0,0,0,12" />

        <StackPanel x:Name="ConfirmPanel">
            <TextBlock Text="{loc:Loc Backup_PasswordConfirmField}" Style="{StaticResource FieldLabel}" />
            <PasswordBox x:Name="PasswordBox2"
                         Background="{DynamicResource PrimaryBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         CaretBrush="{DynamicResource TextPrimaryBrush}"
                         BorderBrush="{DynamicResource BorderBrush}"
                         BorderThickness="1"
                         FontSize="13"
                         Padding="10,8"
                         Margin="0,0,0,12" />
        </StackPanel>

        <TextBlock x:Name="ErrorText"
                   Foreground="{DynamicResource DangerBrush}"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"
                   Margin="0,0,0,12" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{loc:Loc Common_Cancel}"
                    Style="{StaticResource SecondaryButton}"
                    Click="OnCancelClick"
                    Margin="0,0,8,0" />
            <Button x:Name="OkButton"
                    Content="{loc:Loc Common_OK}"
                    Style="{StaticResource PrimaryButton}"
                    Click="OnOkClick"
                    IsDefault="True" />
        </StackPanel>

    </StackPanel>
</Window>
